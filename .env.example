# Independent BPE BOT deployment. Never prefix secrets with NEXT_PUBLIC_.
DATABASE_URL=postgresql://user:password@localhost:55432/bpebot
DB_SCHEMA_MODE=verify
DB_SCHEMA_TOKEN=
QQ_APP_ID=
QQ_CLIENT_SECRET=
# Existing platform, accessible to this server. Cookies must be shared through
# the same host (reverse proxy) or a deliberately configured shared cookie domain.
PLATFORM_URL=http://127.0.0.1:3000
PLATFORM_DATABASE_URL=
APP_URL=http://127.0.0.1:3100
